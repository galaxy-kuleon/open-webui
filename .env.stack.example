# Stack-wide environment variables for docker-compose.stack.yml
# Copy this file and fill in your secrets, then run:
#   docker compose -f docker-compose.stack.yml up -d --build
#
# NOTE: This file is read by Docker Compose for variable substitution
#       AND by the Honcho containers via env_file. Keep it safe.

# =============================================================================
# Open WebUI
# =============================================================================
# Generate once with: head -c 32 /dev/urandom | base64
WEBUI_SECRET_KEY=changeme-generate-a-strong-secret

# =============================================================================
# Hermes Agent
# =============================================================================
# API_SERVER_KEY: Hermes API server requires this Bearer token from clients.
API_SERVER_KEY=changeme-hermes-server-key

# HERMES_API_KEY: Open WebUI presents this key when calling Hermes.
# MUST be identical to API_SERVER_KEY.
HERMES_API_KEY=${API_SERVER_KEY}

# OPENCODE_GO_API_KEY: Hermes uses this to call its upstream LLM provider.
OPENCODE_GO_API_KEY=changeme-upstream-llm-key

# =============================================================================
# Honcho (LLM provider & feature configs)
# =============================================================================
# Honcho needs an LLM for deriver, dialectic, summary, dream, etc.
# Quick-start: set LLM_OPENAI_API_KEY for OpenAI-compatible endpoints
# (OpenRouter, Together, Fireworks, vLLM, Ollama, LiteLLM, etc.)
LLM_OPENAI_API_KEY=changeme-llm-provider-key

# ── Application ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
NAMESPACE=hermes-local

# ── Auth (set to true + AUTH_JWT_SECRET for production) ──────────────────────
AUTH_USE_AUTH=false
# AUTH_JWT_SECRET=generate-with-python-scripts-generate_jwt_secret-py

# ── Deriver (background memory-extraction worker) ────────────────────────────
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=moonshotai/kimi-k2.6:nitro
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1

# ── Dialectic: all five reasoning levels ─────────────────────────────────────
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=moonshotai/kimi-k2.6:nitro
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=moonshotai/kimi-k2.6:nitro
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=moonshotai/kimi-k2.6:nitro
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=moonshotai/kimi-k2.6:nitro
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=moonshotai/kimi-k2.6:nitro
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1

# ── Summary (compression of long sessions) ───────────────────────────────────
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=moonshotai/kimi-k2.6:nitro
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1

# ── Dream (deduction + induction background consolidation) ───────────────────
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=moonshotai/kimi-k2.6:nitro
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_INDUCTION_MODEL_CONFIG__MODEL=moonshotai/kimi-k2.6:nitro
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1

# ── Embeddings ───────────────────────────────────────────────────────────────
# Disabled by default: OpenRouter does not expose OpenAI-format embedding endpoints
EMBED_MESSAGES=false
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1

# ── Vector store ─────────────────────────────────────────────────────────────
VECTOR_STORE_TYPE=pgvector
VECTOR_STORE_MIGRATED=false
